# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_BACKEND_URL=http://localhost:3000
INTERNAL_SERVICE_SECRET=ai-banking-internal-secret-key

# LLM Provider: 'gemini' | 'openai' | 'mock'
# If no API key is provided, system automatically uses deterministic mock provider for testing/offline mode
LLM_PROVIDER=gemini

# Google Gemini API Configuration (if using Gemini)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Chroma Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
